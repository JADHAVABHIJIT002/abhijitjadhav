# Contact form email (src/lib/contact.ts), sent via nodemailer/SMTP.
# Copy this file to .env and fill in real values — .env is gitignored.
#
# NOTE: SMTP works when this app runs on Node (e.g. `npm run dev`, or a plain
# Node deploy target). It will NOT work once deployed to Cloudflare Workers
# (this project's build target) — Workers don't support outbound SMTP.

# For Gmail: smtp.gmail.com, port 465, and an App Password (not your login
# password) — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# Optional: force TLS on/off instead of inferring from the port.
# SMTP_SECURE=true

# Optional: where contact-form messages are sent. Defaults to the email in
# src/components/site/data.ts (LINKS.email) if unset.
CONTACT_TO_EMAIL=jadhavabhijeet002@gmail.com
